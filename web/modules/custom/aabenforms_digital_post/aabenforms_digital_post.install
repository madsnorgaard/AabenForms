<?php

/**
 * @file
 * Install, update, and uninstall functions for aabenforms_digital_post.
 *
 * Creates the {aabenforms_digital_post_log} table which is the storage
 * backing for the fake_db test mode and the audit trail of every send
 * attempt regardless of mode.
 */

/**
 * Implements hook_schema().
 */
function aabenforms_digital_post_schema(): array {
  $schema['aabenforms_digital_post_log'] = [
    'description' => 'Audit log of all Digital Post send attempts. In fake_db test mode this is also the pretend delivery target.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'transaction_id' => [
        'description' => 'UUID v4 generated for the send attempt. Unique per attempt.',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'mode' => [
        'description' => 'Test mode in effect when the send was attempted: fake_db, wiremock, live_test, live.',
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
      ],
      'channel' => [
        'description' => 'Delivery channel of this row: digital (MeMo/SF1601) or physical (print).',
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'digital',
      ],
      'recipient_type' => [
        'description' => 'cpr or cvr.',
        'type' => 'varchar',
        'length' => 8,
        'not null' => TRUE,
      ],
      'recipient_identifier_hash' => [
        'description' => 'SHA-256 of the recipient CPR or CVR. Never store the raw identifier here.',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'sender_cvr' => [
        'description' => 'Sender CVR (public, safe to store plaintext).',
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
      ],
      'subject' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'status' => [
        'description' => 'success, failure, pending; queued_print for a (DEMO) physical print job.',
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
      ],
      'reason_code' => [
        'description' => 'Typed failure reason when status=failure; see Result class constants.',
        'type' => 'varchar',
        'length' => 32,
        'not null' => FALSE,
      ],
      'payload' => [
        'description' => 'JSON serialization of the DigitalPost DTO sent. Attachments are referenced by path + size, not inlined.',
        'type' => 'text',
        'size' => 'medium',
        'not null' => TRUE,
      ],
      'response' => [
        'description' => 'Transport response body (may be empty for fake_db).',
        'type' => 'text',
        'size' => 'medium',
        'not null' => FALSE,
      ],
      'created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'transaction_id' => ['transaction_id'],
    ],
    'indexes' => [
      'status' => ['status'],
      'mode' => ['mode'],
      'channel' => ['channel'],
      'created' => ['created'],
      'recipient' => ['recipient_type', 'recipient_identifier_hash'],
    ],
  ];
  return $schema;
}

/**
 * Add the delivery channel column and the registration lookup setting.
 *
 * Digital Post fritagelse (#242): every log row records whether it was a
 * digital send or a (DEMO) physical print job. Existing rows were all
 * digital, which the column default records.
 */
function aabenforms_digital_post_update_11001(): string {
  $schema = \Drupal::database()->schema();
  $table = 'aabenforms_digital_post_log';
  $messages = [];
  if ($schema->tableExists($table) && !$schema->fieldExists($table, 'channel')) {
    $schema->addField($table, 'channel', [
      'description' => 'Delivery channel of this row: digital (MeMo/SF1601) or physical (print).',
      'type' => 'varchar',
      'length' => 16,
      'not null' => TRUE,
      'default' => 'digital',
    ]);
    $schema->addIndex($table, 'channel', ['channel'], [
      'fields' => [
        'channel' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'digital'],
      ],
    ]);
    $messages[] = 'Added the channel column to aabenforms_digital_post_log.';
  }
  $config = \Drupal::configFactory()->getEditable('aabenforms_digital_post.settings');
  if ($config->get('registration_lookup') === NULL) {
    $config->set('registration_lookup', 'demo')->save();
    $messages[] = 'Set registration_lookup to demo.';
  }
  return $messages === [] ? 'Nothing to do.' : implode(' ', $messages);
}
