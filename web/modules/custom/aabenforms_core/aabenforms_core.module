<?php

/**
 * @file
 * ÅbenForms Core module.
 *
 * Provides foundation services for Danish government integrations:
 * - ServiceplatformenClient: SOAP client for SF1500 services
 * - EncryptionService: Field-level AES-256 encryption for sensitive data
 * - AuditLogger: GDPR-compliant audit logging for CPR/CVR lookups
 * - TenantResolver: Multi-tenant domain detection
 * - AabenformsDashboardSection plugin manager (admin dashboard).
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;
use Drupal\user\Entity\User;
use Drupal\webform\WebformSubmissionInterface;

/**
 * Implements hook_help().
 */
function aabenforms_core_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.aabenforms_core':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('ÅbenForms Core provides foundation services for Danish government service integrations. This module is required by all other ÅbenForms modules.') . '</p>';
      $output .= '<h3>' . t('Features') . '</h3>';
      $output .= '<dl>';
      $output .= '<dt>' . t('Serviceplatformen Integration') . '</dt>';
      $output .= '<dd>' . t('SOAP client for connecting to Danish government services (SF1520 CPR lookup, SF1530 CVR lookup, SF1601 Digital Post).') . '</dd>';
      $output .= '<dt>' . t('Field Encryption') . '</dt>';
      $output .= '<dd>' . t('AES-256 encryption for sensitive personal data (CPR numbers) to ensure GDPR compliance.') . '</dd>';
      $output .= '<dt>' . t('Audit Logging') . '</dt>';
      $output .= '<dd>' . t('Comprehensive logging of all sensitive data access for compliance and security auditing.') . '</dd>';
      $output .= '<dt>' . t('Multi-Tenancy') . '</dt>';
      $output .= '<dd>' . t('Integration with Domain module for tenant-specific configuration and data isolation.') . '</dd>';
      $output .= '<dt>' . t('Admin Dashboard') . '</dt>';
      $output .= '<dd>' . t('Unified entry point at <a href=":url">/admin/aabenforms</a> showing each module\'s state, recent activity, and quick actions.', [
        ':url' => Url::fromRoute('aabenforms_core.dashboard')->toString(),
      ]) . '</dd>';
      $output .= '</dl>';
      return $output;
  }
}

/**
 * Implements hook_toolbar().
 *
 * Registers a top-bar tab that links to the AabenForms admin dashboard
 * from anywhere in the admin UI. The link only renders for users with
 * the dashboard permission so the tab is invisible to ordinary editors.
 */
function aabenforms_core_toolbar(): array {
  $access = \Drupal::currentUser()->hasPermission('access aabenforms admin');
  // Defensive: Url::fromRoute throws if the dashboard route is briefly
  // missing (e.g. mid cim/cr cycle on deploy). Suppress that case so the
  // toolbar - which renders on every admin page - never 500s.
  try {
    $url = Url::fromRoute('aabenforms_core.dashboard');
  }
  catch (\Throwable $e) {
    \Drupal::logger('aabenforms_core')->warning(
      'Toolbar tab skipped: dashboard route not available (@msg)',
      ['@msg' => $e->getMessage()],
    );
    return [];
  }
  return [
    'aabenforms' => [
      '#type' => 'toolbar_item',
      '#weight' => -200,
      '#access' => $access,
      'tab' => [
        '#type' => 'link',
        '#title' => t('AabenForms'),
        '#url' => $url,
        '#attributes' => [
          'title' => t('AabenForms admin dashboard'),
          'class' => ['toolbar-icon', 'toolbar-icon-aabenforms'],
        ],
      ],
      '#cache' => [
        'contexts' => ['user.permissions'],
      ],
      '#attached' => [
        'library' => ['aabenforms_core/toolbar'],
      ],
    ],
  ];
}

/**
 * Implements hook_theme().
 */
function aabenforms_core_theme(): array {
  return [
    'aabenforms_dashboard' => [
      'variables' => [
        'header' => [],
        'quick_actions' => [],
        'sections' => [],
        'activity' => NULL,
      ],
    ],
    'aabenforms_dashboard_section_card' => [
      'variables' => [
        'section_id' => '',
        'label' => '',
        'status_badge' => NULL,
        'hero_metric' => NULL,
        'secondary_metrics' => [],
        'main_link' => [],
        'secondary_link' => [],
      ],
    ],
    'aabenforms_dashboard_landing' => [
      'variables' => [
        'title' => '',
        'tagline' => '',
        'frontend_url' => '',
        'login_url' => '',
        'docs_url' => '',
      ],
    ],
    'aabenforms_dashboard_activity' => [
      'variables' => [
        'filter' => 'errors',
        'filters' => [],
        'rows' => [],
        'pivoted' => FALSE,
        'empty_message' => '',
      ],
    ],
  ];
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 *
 * The standard /user/login form sets $form_state->setRedirect('user.page')
 * as its default landing target (which resolves to /user/{uid}). We want
 * users with the dashboard permission to land on /admin/aabenforms
 * instead. Inject our own submit handler that runs AFTER Drupal core's
 * default and overrides the redirect when applicable.
 *
 * Guards: skip if the user supplied an explicit ?destination=
 * (RedirectResponseSubscriber will honor that anyway).
 */
function aabenforms_core_form_user_login_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form['#submit'][] = 'aabenforms_core_user_login_form_redirect';
}

/**
 * Submit handler for user_login_form. Sends admins to /admin/aabenforms.
 */
function aabenforms_core_user_login_form_redirect(array &$form, FormStateInterface $form_state): void {
  if (\Drupal::request()->query->has('destination')) {
    return;
  }
  $uid = (int) $form_state->get('uid');
  if (!$uid) {
    return;
  }
  $account = User::load($uid);
  if ($account && $account->hasPermission('access aabenforms admin')) {
    $form_state->setRedirect('aabenforms_core.dashboard');
  }
}

/**
 * Implements hook_user_login().
 *
 * Covers the non-form login paths: password-reset URL, SSO callbacks,
 * Drush uli, etc. The standard /user/login flow is handled by the
 * form-alter above (more reliable than nudging request->query).
 *
 * Guards: skip if a destination is already set, skip on the password-
 * reset route's own form (it has its own redirect logic), only act
 * when the account has access aabenforms admin.
 */
function aabenforms_core_user_login($account): void {
  if (!$account->hasPermission('access aabenforms admin')) {
    return;
  }
  $request = \Drupal::request();
  if ($request->query->has('destination')) {
    return;
  }
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (in_array($route_name, ['user.reset', 'user.reset.login', 'user.reset.form'], TRUE)) {
    return;
  }
  $request->query->set('destination', '/admin/aabenforms');
}

/**
 * Implements hook_cron().
 *
 * Purges audit log entries older than the configured retention window.
 * Default is 1825 days (5 years) to align with GDPR audit-retention
 * expectations. Set aabenforms_core.settings audit.retention_days to 0 to
 * disable purging, or raise the batch size if cron falls behind.
 */
function aabenforms_core_cron(): void {
  $config = \Drupal::config('aabenforms_core.settings');
  $retention = (int) $config->get('audit.retention_days');
  if ($retention < 1) {
    return;
  }
  /** @var \Drupal\aabenforms_core\Service\AuditLogger $logger */
  $logger = \Drupal::service('aabenforms_core.audit_logger');
  $deleted = $logger->purge($retention);
  if ($deleted > 0) {
    \Drupal::logger('aabenforms_core')->info(
      'Audit log purge removed @count entries older than @days days.',
      ['@count' => $deleted, '@days' => $retention]
    );
  }
}

/**
 * Implements hook_page_attachments().
 *
 * Attaches AabenForms favicons and OpenGraph/Twitter share metadata to
 * every Drupal page. Gives api.aabenforms.dk a recognisable identity
 * when bookmarked, pasted into chat clients, or surfaced in browsers.
 */
function aabenforms_core_page_attachments(array &$attachments): void {
  $module_path = \Drupal::service('extension.list.module')
    ->getPath('aabenforms_core');
  $brand_base = '/' . $module_path . '/assets/brand';

  // Slack and a couple of other crawlers ignore relative og:image URLs,
  // so resolve to an absolute URL using the request scheme + host.
  $request = \Drupal::request();
  $absolute = $request->getSchemeAndHttpHost();
  $og_image = $absolute . $brand_base . '/og-image.png';

  $description = (string) t('Backend admin console for the AabenForms platform.');

  $tags = [
    [
      'link',
      [
        'rel' => 'icon',
        'type' => 'image/svg+xml',
        'href' => $brand_base . '/favicon.svg',
      ],
      'aabenforms_icon_svg',
    ],
    [
      'link',
      [
        'rel' => 'icon',
        'type' => 'image/png',
        'sizes' => '32x32',
        'href' => $brand_base . '/favicon-32.png',
      ],
      'aabenforms_icon_32',
    ],
    [
      'link',
      [
        'rel' => 'apple-touch-icon',
        'sizes' => '180x180',
        'href' => $brand_base . '/apple-touch-icon-180.png',
      ],
      'aabenforms_icon_apple',
    ],
    ['meta', ['name' => 'theme-color', 'content' => '#0071b9'], 'aabenforms_theme_color'],
    ['meta', ['name' => 'description', 'content' => $description], 'aabenforms_description'],
    ['meta', ['property' => 'og:type', 'content' => 'website'], 'aabenforms_og_type'],
    ['meta', ['property' => 'og:site_name', 'content' => 'AabenForms'], 'aabenforms_og_site'],
    ['meta', ['property' => 'og:title', 'content' => 'AabenForms backend'], 'aabenforms_og_title'],
    [
      'meta',
      ['property' => 'og:description', 'content' => $description],
      'aabenforms_og_description',
    ],
    ['meta', ['property' => 'og:image', 'content' => $og_image], 'aabenforms_og_image'],
    ['meta', ['property' => 'og:image:width', 'content' => '1200'], 'aabenforms_og_image_w'],
    ['meta', ['property' => 'og:image:height', 'content' => '630'], 'aabenforms_og_image_h'],
    [
      'meta',
      ['name' => 'twitter:card', 'content' => 'summary_large_image'],
      'aabenforms_twitter_card',
    ],
    [
      'meta',
      ['name' => 'twitter:title', 'content' => 'AabenForms backend'],
      'aabenforms_twitter_title',
    ],
    [
      'meta',
      ['name' => 'twitter:description', 'content' => $description],
      'aabenforms_twitter_description',
    ],
    ['meta', ['name' => 'twitter:image', 'content' => $og_image], 'aabenforms_twitter_image'],
  ];

  foreach ($tags as [$type, $attrs, $key]) {
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => $type,
        '#attributes' => $attrs,
      ],
      $key,
    ];
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave() for webform_submission entities.
 *
 * Encrypts every cpr_field value before it is written to the database, so
 * CPR numbers are not stored in plaintext at rest. The companion reveal()
 * happens at the points of use (CPR lookup, Digital Post recipient, audit
 * hashing). Encryption is idempotent, so re-saving a submission does not
 * double-encrypt.
 */
function aabenforms_core_webform_submission_presave(WebformSubmissionInterface $submission): void {
  $webform = $submission->getWebform();
  if ($webform === NULL) {
    return;
  }
  /** @var \Drupal\aabenforms_core\Service\CprAccess $cprAccess */
  $cprAccess = \Drupal::service('aabenforms_core.cpr_access');
  foreach ($webform->getElementsInitializedAndFlattened() as $key => $element) {
    // A field holds a CPR when it uses the cpr_field element, or - because
    // several citizen forms use a plain textfield - when its key is "cpr" or
    // ends in "_cpr" (cpr, child_cpr, applicant_cpr, partner1_cpr, ...).
    $is_cpr = ($element['#type'] ?? '') === 'cpr_field'
      || $key === 'cpr'
      || str_ends_with($key, '_cpr');
    if (!$is_cpr) {
      continue;
    }
    $value = $submission->getElementData($key);
    if (is_string($value) && $value !== '') {
      $submission->setElementData($key, $cprAccess->protect($value));
    }
  }

  aabenforms_core_protect_decision_fields($submission);
}

/**
 * Keeps decision-state fields out of the submitter's hands.
 *
 * Workflow state lives in hidden webform elements (parent<N>_status,
 * caseworker_status, consent_status) that ECA flows gate on: a caseworker
 * approval triggers a binding afgoerelse with decision letters. "Hidden" is
 * a rendering hint, NOT an access control - the API controller and the form
 * both accept whatever the client posts - so without this guard a citizen
 * could submit caseworker_status=approved and have the municipality issue a
 * decision with no review at all.
 *
 * The rule: only an authenticated employee (or the CLI/cron, where flows and
 * drush act on the platform's behalf) may set these fields to a non-default
 * value. Everyone else has them forced back to the element default. The
 * legitimate citizen path is untouched, because parent approvals are written
 * server-side by ParentApprovalForm after the MitID + CPR + custody gates,
 * running as the same anonymous session but through code, not payload - so
 * the guard exempts only what the form itself sets on an already-persisted
 * submission (see $submission->isNew()).
 *
 * @param \Drupal\webform\WebformSubmissionInterface $submission
 *   The submission being saved.
 */
function aabenforms_core_protect_decision_fields(WebformSubmissionInterface $submission): void {
  // Server-side actors (drush, cron, queue workers) are trusted: ECA flows and
  // the approval form run there and legitimately advance workflow state.
  if (PHP_SAPI === 'cli') {
    return;
  }

  $account = \Drupal::currentUser();
  if ($account->hasPermission('administer aabenforms decision state') || $account->hasRole('aabenforms_employee')) {
    return;
  }

  $webform = $submission->getWebform();
  if ($webform === NULL) {
    return;
  }

  // Only guard the CREATE path from a browser/API client. Updates from the
  // citizen approval flow are made by server-side code after the identity,
  // CPR and custody gates have run.
  //
  // This is only sufficient because no client-driven UPDATE path exists:
  // jsonapi.settings ships read_only, and the decision-bearing webforms ship
  // `draft: none` with prepopulate off, so a citizen cannot re-open a stored
  // submission and post a new caseworker_status. Both of those are settings
  // rather than code, so ProtectDecisionFieldsTest asserts them; if either
  // changes, this guard has to cover updates too.
  if (!$submission->isNew()) {
    return;
  }

  $guarded = 0;
  foreach ($webform->getElementsInitializedAndFlattened() as $key => $element) {
    if ($key !== 'caseworker_status' && $key !== 'consent_status' && !preg_match('/^parent\d+_status$/', $key)) {
      continue;
    }
    $default = $element['#default_value'] ?? '';
    if ((string) $submission->getElementData($key) !== (string) $default) {
      $submission->setElementData($key, $default);
      $guarded++;
    }
  }

  if ($guarded > 0) {
    \Drupal::logger('aabenforms_core')->warning(
      'Blocked @count submitter-supplied decision-state field(s) on webform @form; reset to defaults.',
      ['@count' => $guarded, '@form' => $webform->id()]
    );
  }
}
